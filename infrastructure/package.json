{
  "name": "@ocoda/website-infrastructure",
  "version": "1.0.0",
  "description": "Ocoda.be Website Infrastructure",
  "bin": {
    "infrastructure": "bin/main.js"
  },
  "scripts": {
    "aws:login": "aws sso login --sso-session ocoda",
    "build": "cdk synth--profile ocoda-production --all",
    "diff": "cdk diff --profile ocoda-production --all",
    "deploy": "cdk deploy --profile ocoda-production --all --require-approval never",
    "format": "biome format ./bin ./lib --write",
    "lint": "biome check ./bin ./lib --apply"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.438.0",
    "@biomejs/biome": "1.2.2",
    "@types/aws-lambda": "^8.10.125",
    "@types/jest": "^29.5.5",
    "@types/node": "20.7.1",
    "aws-cdk": "2.166.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "~5.2.2"
  },
  "dependencies": {
    "aws-cdk-lib": "2.166.0",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  }
}
